{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "specgym.test-suite.v0",
  "title": "Test Suite Draft",
  "type": "object",
  "required": ["title", "tests", "sourceNodeIds"],
  "properties": {
    "title": { "type": "string" },
    "tests": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "title", "kind", "sourceNodeIds"],
        "properties": {
          "id": { "type": "string" },
          "title": { "type": "string" },
          "kind": {
            "enum": ["acceptance", "negative", "invariant", "regression", "property", "open_question"]
          },
          "assertion": { "type": "string" },
          "sourceNodeIds": { "type": "array", "items": { "type": "string" } },
          "anchors": { "type": "array", "items": { "type": "string" } },
          "inferred": { "type": "boolean" }
        },
        "additionalProperties": true
      }
    },
    "sourceNodeIds": { "type": "array", "items": { "type": "string" } },
    "openQuestions": { "type": "array", "items": { "type": "string" } }
  },
  "additionalProperties": true
}
