{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "specgym.projection.schema.v0",
  "title": "Spec Gym Projection",
  "type": "object",
  "required": ["id", "title", "output", "outputPath", "inputForms"],
  "properties": {
    "id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]*$" },
    "title": { "type": "string" },
    "output": { "enum": ["json", "markdown", "proto"] },
    "outputPath": { "type": "string" },
    "types": { "type": "array", "items": { "type": "string" } },
    "inputForms": { "type": "array", "items": { "type": "string" } },
    "includeInAll": { "type": "boolean" },
    "reverseOf": { "type": "string" },
    "trainableWith": { "type": "array", "items": { "type": "string" } },
    "matchNodeTypes": { "type": "array", "items": { "type": "string" } },
    "keywords": { "type": "array", "items": { "type": "string" } },
    "focusStrategy": { "type": "string" },
    "mergeStrategy": { "type": "string" }
  },
  "additionalProperties": true
}
