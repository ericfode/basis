{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "basis.implementation-question.v0",
  "title": "Implementation Question",
  "type": "object",
  "required": ["id", "question", "sourceNodeIds"],
  "properties": {
    "id": { "type": "string" },
    "question": { "type": "string" },
    "reason": { "type": "string" },
    "sourceNodeIds": { "type": "array", "items": { "type": "string" } },
    "blocksImplementation": { "type": "boolean" }
  },
  "additionalProperties": true
}
