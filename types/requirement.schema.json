{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "basis.requirement.v0",
  "title": "Requirement",
  "type": "object",
  "required": ["id", "text", "source"],
  "properties": {
    "id": { "type": "string" },
    "text": { "type": "string" },
    "normative": { "type": "array", "items": { "type": "string" } },
    "source": {
      "type": "object",
      "required": ["path", "lineStart", "lineEnd"],
      "properties": {
        "path": { "type": "string" },
        "lineStart": { "type": "integer" },
        "lineEnd": { "type": "integer" }
      }
    },
    "tags": { "type": "array", "items": { "type": "string" } }
  },
  "additionalProperties": true
}
