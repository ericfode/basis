{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "specgym.projection-cycle.v0",
  "title": "Projection Cycle Training Plan",
  "type": "object",
  "required": ["schemaVersion", "cycleId", "source", "forward", "reverse", "rounds"],
  "properties": {
    "schemaVersion": { "const": "specgym.projection-cycle-training-plan.v0" },
    "cycleId": { "type": "string" },
    "source": { "type": "object" },
    "forward": { "type": "object" },
    "reverse": { "type": "object" },
    "iterations": { "type": "integer", "minimum": 1 },
    "rounds": { "type": "array", "items": { "type": "object" } },
    "acceptance": { "type": "object" }
  },
  "additionalProperties": true
}
